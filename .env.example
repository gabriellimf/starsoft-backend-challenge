DATABASE_URL=postgresql://cinema:cinema123@localhost:5432/cinemadb
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema123
POSTGRES_DB=cinemadb
DB_LOGGING=true
DB_SSL=false
DB_SYNCHRONIZE=true
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RESEND_KEY=your-resend-api-key-here
MAIL_FROM_ADDRESS=cinema@yourdomain.com
ALERTS_EMAIL_TO=alerts@yourdomain.com
ZOOKEEPER_SERVER_ID=1
ZOOKEEPER_SERVERS=0.0.0.0:2888:3888
KAFKA_BROKERS=localhost:3002
KAFKA_CLIENT_ID=cinema-api
KAFKAJS_NO_PARTITIONER_WARNING=1
# Set to true for development mode (mocks Kafka operations)
KAFKA_MOCK_MODE=false
KAFKA_DLQ_TOPIC=cinema-dlq
KAFKA_REPLICATION_FACTOR=1
KAFKA_BROKER_ID=1
KAFKA_MIN_ISR=1
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_MESSAGE_MAX_BYTES=1048576
ELASTICSEARCH_NODE=http://localhost:3003
ELASTIC_EVENTS_INDEX=cinema-events
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password
GRAFANA_ALLOW_SIGN_UP=false
ELASTICSEARCH_NODE_NAME=elasticsearch
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
ELASTICSEARCH_MEMORY_LOCK=true
ELASTICSEARCH_SECURITY_ENABLED=false
ELASTICSEARCH_DISCOVERY_TYPE=single-node
ELASTICSEARCH_CLUSTER_NAME=cinema-cluster
PROMETHEUS_RETENTION_TIME=200h
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100